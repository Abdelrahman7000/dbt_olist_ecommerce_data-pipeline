arrier_date,\n    order_delivered_customer_date,\n    order_estimated_delivery_date,\n    \n    -- Delivery Duration in Days\n    EXTRACT(DAY FROM (order_delivered_customer_date - order_purchase_timestamp)) as days_to_deliver,\n    \n    -- Estimate Difference (Negative means delivered earlier than estimated)\n    EXTRACT(DAY FROM (order_delivered_customer_date - order_estimated_delivery_date)) as delivery_delay_days,\n    \n    EXTRACT(DAY FROM (order_estimated_delivery_date - order_purchase_timestamp)) as estimated_delivery_days,\n    \n    -- Operational Flag\n    case \n        when order_delivered_customer_date > order_estimated_delivery_date and order_status = 'delivered'then true \n        when order_delivered_customer_date < order_estimated_delivery_date and order_status = 'delivered'then false\n        else null \n    end as is_delivery_delayed\n\nfrom orders", "relation_name": "\"ecommerce_db\".\"intermediate\".\"int_orders\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-20T14:20:01.981143Z", "completed_at": "2026-10-20T14:20:02.012527Z"}, {"name": "execute", "started_at": "2026-10-20T14:20:02.022791Z", "completed_at": "2026-10-20T14:21:04.262056Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 62.364904165267944, "adapter_response": {"_message": "SELECT 1000163", "code": "SELECT", "rows_affected": 1000163}, "message": "SELECT 1000163", "failures": null, "unique_id": "model.ecommerce_analytics.int_location", "compiled": true, "compiled_code": "with location as (\n    SELECT \n        geolocation_zip_code_prefix,\n        geolocation_lat :: DOUBLE PRECISION,\n        geolocation_lng :: DOUBLE PRECISION,\n        lower(geolocation_city) as geolocation_city,\n        upper(geolocation_state) as geolocation_state\n    FROM \"ecommerce_db\".\"raw\".\"stg_location\"\n)\nSELECT *\nFROM location", "relation_name": "\"ecommerce_db\".\"intermediate\".\"int_location\"", "batch_r